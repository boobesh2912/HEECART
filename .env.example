# Copy to .env for local development, and add the same values in Vercel / Cloudflare
# (Project settings -> Environment variables). Nothing here is secret: Vite puts these in the public site.

# The hidden CRM link: https://your-site/venkatesh
VITE_CRM_PATH=venkatesh

# The repo + branch the CRM saves to (the same one Vercel / Cloudflare deploys from).
VITE_GITHUB_REPO=boobesh2912/HEECART
VITE_GITHUB_BRANCH=main
